<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>L7-BatteryInfo</AssemblyName>
    <ApplicationIcon>Assets\L7-BatteryInfo.ico</ApplicationIcon>
    <RootNamespace>MouseBatteryTray</RootNamespace>
    <Version>0.1.1</Version>
    <Product>L7-BatteryInfo</Product>
    <Description>L7-BatteryInfo wireless mouse battery monitor</Description>
    <AssemblyTitle>L7-BatteryInfo wireless mouse battery monitor</AssemblyTitle>
    <Company>MateFoxer</Company>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RepositoryUrl>https://github.com/MateFoxer/L7-BatteryInfo</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\mouse.png" />
    <AssemblyMetadata Include="RepositoryUrl" Value="$(RepositoryUrl)" />
    <ProjectReference Include="..\MouseBatteryTray.Hid\MouseBatteryTray.Hid.csproj" />
  </ItemGroup>
</Project>
